h=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="494" y="894" width="24" height="24" as="geometry"/></mxCell><mxCell id="cC" value="C" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="714" y="894" width="24" height="24" as="geometry"/></mxCell><mxCell id="cD" value="D" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="934" y="894" width="24" height="24" as="geometry"/></mxCell><mxCell id="cE" value="E" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1174" y="894" width="24" height="24" as="geometry"/></mxCell><mxCell id="cF" value="F" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="560" y="444" width="24" height="24" as="geometry"/></mxCell><mxCell id="cG" value="G" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="644" y="584" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;b&gt;Online path — every hour&lt;/b&gt; (black callouts)&lt;br&gt;&lt;b&gt;1&lt;/b&gt; EventBridge Scheduler starts the Step Functions pipeline at :07 (retries :27 and :47 if source data is late; every step is idempotent).&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Collector fetches Air4Thai, Open-Meteo and OpenAQ.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Collector lands the raw JSON in the S3 lakehouse (bronze) and upserts observations into Aurora.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Predict loads the champion and challenger models from S3 (versions in SSM) and features from Aurora, then writes the 24-hour forecast; the challenger runs in shadow only.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Score compares past forecasts with new observations and writes metrics to Aurora and the lakehouse.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Dashboard builder renders a static site from Aurora into S3.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; CloudFront (Origin Access Control) serves the dashboard to viewers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Offline path — Databricks serverless&lt;/b&gt; (white callouts)&lt;br&gt;&lt;b&gt;A&lt;/b&gt; ETL jobs read bronze from S3 through a Unity Catalog storage credential and build silver/gold Delta tables.&lt;br&gt;&lt;b&gt;B&lt;/b&gt; Data-quality checks gate training; a failure alerts Discord (page 2).&lt;br&gt;&lt;b&gt;C&lt;/b&gt; Weekly training logs runs to MLflow and registers a new version as &lt;i&gt;challenger&lt;/i&gt;.&lt;br&gt;&lt;b&gt;D&lt;/b&gt; Evaluation gates pass, then a person reviews and moves the &lt;i&gt;champion&lt;/i&gt; alias.&lt;br&gt;&lt;b&gt;E&lt;/b&gt; Promotion job exports both models to S3 and updates SSM; the next hourly run picks them up. Serving never calls Databricks.&lt;br&gt;&lt;b&gt;F&lt;/b&gt; Forecast and score history in the lakehouse feeds drift monitoring and the next training run.&lt;br&gt;&lt;b&gt;G&lt;/b&gt; &lt;i&gt;Planned:&lt;/i&gt; each month SageMaker AI AutoML V2 (time-series) trains on the same gold export and split; its metrics go to the MLflow leaderboard as a benchmark. It is not served; Unity Catalog stays the only registry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Feature logic lives in one Python package used by Predict and by Databricks jobs; the feature-parity test is a release gate.&lt;br&gt;• Arrows inside the Step Functions frame are state order, not Lambda-to-Lambda calls.&lt;br&gt;• Dashed arrow = configuration read/write, not data.&lt;br&gt;• Aurora Serverless v2 can be set to min 0 ACU (auto-pause after ≥5 min idle); only the pipeline touches it, because viewers read the static site." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;spacing=4;" vertex="1" parent="1"><mxGeometry x="1600" y="330" width="520" height="640" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Network, security &amp; operations" id="pm25-v6-net"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;PM2.5 Bangkok 24-hour forecast — network, security &amp;amp; operations&lt;/b&gt; (v6 · target production design, not deployed)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#000000;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="30" as="geometry"/></mxCell><mxCell id="ext" value="Outside AWS" style="rounded=0;dashed=1;strokeColor=#AAB7B8;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#545B64;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="520" as="geometry"/></mxCell><mxCell id="gh" value="GitHub Actions&lt;br&gt;CI/CD (OIDC)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#000000;fontSize=12;" vertex="1" parent="ext"><mxGeometry x="25" y="50" width="150" height="56" as="geometry"/></mxCell><mxCell id="apis" value="External data APIs&lt;br&gt;Air4Thai · Open-Meteo · OpenAQ" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#000000;fontSize=12;" vertex="1" parent="ext"><mxGeometry x="25" y="230" width="150" height="70" as="geometry"/></mxCell><mxCell id="discord" value="Discord alerts" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#000000;fontSize=12;" vertex="1" parent="ext"><mxGeometry x="25" y="420" width="150" height="50" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud (our account)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="280" y="50" width="1380" height="760" as="geometry"/></mxCell><mxCell id="reg" value="Region: Asia Pacific (Singapore) ap-southeast-1" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="cloud"><mxGeometry x="20" y="40" width="1340" height="700" as="geometry"/></mxCell><mxCell id="vpc" value="VPC 10.0.0.0/16" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="reg"><mxGeometry x="90" y="50" width="760" height="620" as="geometry"/></mxCell><mxCell id="igw" value="Internet gateway" style="shape=mxgraph.aws4.internet_gateway;fillColor=#8C4FFF;sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fontColor=#000000;fontSize=12;" vertex="1" parent="reg"><mxGeometry x="20" y="280" width="48" height="48" as="geometry"/></mxCell><mxCell id="aza" value="Availability Zone a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpac