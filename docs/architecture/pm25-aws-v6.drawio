arget="discord"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="860"/><mxPoint x="180" y="860"/></Array></mxGeometry></mxCell><mxCell id="c1" value="1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1174" y="164" width="24" height="24" as="geometry"/></mxCell><mxCell id="c2" value="2" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="535" y="264" width="24" height="24" as="geometry"/></mxCell><mxCell id="c3" value="3" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="905" y="574" width="24" height="24" as="geometry"/></mxCell><mxCell id="c4" value="4" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="604" y="444" width="24" height="24" as="geometry"/></mxCell><mxCell id="c6" value="6" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1334" y="484" width="24" height="24" as="geometry"/></mxCell><mxCell id="c5" value="5" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1719" y="284" width="24" height="24" as="geometry"/></mxCell><mxCell id="c7" value="7" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1174" y="484" width="24" height="24" as="geometry"/></mxCell><mxCell id="c8" value="8" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="39" y="504" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; GitHub Actions deploys with a short-lived role through OIDC; there are no stored access keys.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; VPC-attached Lambdas reach the external APIs through the NAT gateway (AZ a) and the internet gateway.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; S3 and Secrets Manager traffic stays private through VPC endpoints and does not pass through the NAT.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Aurora has no public endpoint; its credentials sit in Secrets Manager, encrypted with KMS.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Databricks serverless reads and writes S3 only through a Unity Catalog storage credential (cross-account IAM role); it has no network path into the VPC.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; CloudWatch alarms (dead-man: no successful run in 2 hours; Step Functions FAILED) publish to SNS; the notifier posts to Discord.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; EventBridge also runs the daily Backfill, Housekeeping and Heartbeat Lambdas; Heartbeat proves the alert path works.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Databricks job failures post to Discord through a job notification webhook." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;spacing=4;" vertex="1" parent="1"><mxGeometry x="1700" y="430" width="440" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>