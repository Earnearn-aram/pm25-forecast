ientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="azb"><mxGeometry x="20" y="210" width="310" height="330" as="geometry"/></mxCell><mxCell id="nat" value="NAT gateway" style="shape=mxgraph.aws4.nat_gateway;fillColor=#8C4FFF;sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fontColor=#000000;fontSize=12;" vertex="1" parent="puba"><mxGeometry x="131" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="nonat" value="No NAT here: one NAT keeps cost down; an AZ-a outage pauses collection (accepted risk)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;spacing=4;" vertex="1" parent="pubb"><mxGeometry x="20" y="40" width="270" height="80" as="geometry"/></mxCell><mxCell id="lama" value="Pipeline Lambdas&lt;br&gt;(VPC-attached)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fontColor=#000000;fontSize=12;" vertex="1" parent="priva"><mxGeometry x="40" y="60" width="48" height="48" as="geometry"/></mxCell><mxCell id="aur" value="Aurora Serverless v2&lt;br&gt;writer" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;fillColor=#C925D1;sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fontColor=#000000;fontSize=12;" vertex="1" parent="priva"><mxGeometry x="200" y="60" width="48" height="48" a